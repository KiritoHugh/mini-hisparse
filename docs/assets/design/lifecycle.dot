digraph lifecycle {
  graph [rankdir=LR, bgcolor="white", pad=0.15, nodesep=0.24, ranksep=0.36, fontname="Noto Sans CJK SC", fontsize=13];
  node [shape=box, style="rounded,filled", fillcolor="#F2F6FA", color="#B6C6D6", fontname="Noto Sans CJK SC", fontsize=12, margin="0.12,0.10"];
  edge [color="#64748B", fontcolor="#475569", fontname="Noto Sans CJK SC", fontsize=10, arrowsize=0.7];
  subgraph cluster_page {
    label="页：驻留身份与回收资格"; color="#CBD5E1"; style=rounded;
    dirty [label="Dirty resident\nGPU 有最新版本", fillcolor="#FFF0D8"];
    pinned [label="Clean pinned\nhost 镜像已完成", fillcolor="#DFF0FB"];
    unpinned [label="Clean unpinned\n仍可 resident hit", fillcolor="#DAF3E8"];
    host [label="Host-only\nresident = -1"];
    dirty -> pinned [label="D2H 完成"];
    pinned -> unpinned [label="离开 tail / 无读者\nhot 可接管"];
    unpinned -> host [label="block 真正复用"];
  }
  subgraph cluster_row {
    label="Hot row：内容与可读性"; color="#93C5BD"; style=rounded;
    slot [label="选定未保护 slot\n记录新 tag / 落点"];
    loading [label="Loading\n数据还不能读", fillcolor="#FFF0D8"];
    ready [label="Ready\n可以 attention", fillcolor="#DAF3E8"];
    slot -> loading [label="提交 gather"];
    loading -> ready [label="loaded 事件"];
    ready -> slot [label="旧读者完成后\n可换别的 row", constraint=false];
  }
  host -> slot [style=dashed, label="选中且 hot miss", constraint=false];
}
