digraph overlap {
  graph [rankdir=LR, bgcolor="white", pad=0.15, nodesep=0.28, ranksep=0.35, fontname="Noto Sans CJK SC"];
  node [shape=box, style="rounded,filled", fillcolor="#F2F6FA", color="#B6C6D6", fontname="Noto Sans CJK SC", fontsize=12, margin="0.14,0.10"];
  edge [color="#64748B", fontcolor="#475569", fontname="Noto Sans CJK SC", fontsize=10, arrowsize=0.7];
  resolve [label="Resolve 并分区\n保护所有 selected hits"];
  ready [label="Compute：attention(S_ready)\n输出 m_a、l_a、o_a", fillcolor="#DFF0FB"];
  gather [label="Transfer：gather(S_miss)\n只写未保护 slots", fillcolor="#DAF3E8"];
  missing [label="Compute：attention(S_miss)\n输出 m_b、l_b、o_b", fillcolor="#DFF0FB"];
  merge [label="稳定合并 softmax 统计量\n输出后记录 read_done", fillcolor="#E4EAFB"];
  resolve -> ready; resolve -> gather;
  {rank=same; ready; gather;}
  ready -> missing [label="同 compute stream"];
  gather -> missing [label="加载完成事件"];
  missing -> merge;
  ready -> merge [style=dashed, label="保留部分统计量", constraint=false];
}
